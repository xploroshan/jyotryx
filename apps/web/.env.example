# ─── API ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_WS_URL=ws://localhost:4000

# ─── Cashfree (Client) ──────────────────────────────────────────────────────
# Only the mode is exposed to the browser — never the client secret.
NEXT_PUBLIC_CASHFREE_MODE=sandbox

# ─── Firebase ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abc123

# ─── Google OAuth (optional, used if not using Firebase for Google) ─────────
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id

# ─── Analytics ───────────────────────────────────────────────────────────────
# GA4 measurement ID — marketing/attribution sink. Public by design (ships in
# client JS). NOTE: the var name MUST be NEXT_PUBLIC_GA_ID — that is what the
# code reads (apps/web/src/app/layout.tsx). Leave unset to disable analytics.
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# PostHog — product analytics sink (funnels, retention cohorts). Leave the key
# unset to disable. Host defaults to PostHog Cloud US; use https://eu.i.posthog.com
# for the EU region, or a same-origin reverse-proxy path to dodge ad-blockers.
NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ─── App Config ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=myastro360
NEXT_PUBLIC_APP_URL=http://localhost:3000
