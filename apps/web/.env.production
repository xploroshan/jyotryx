# ─── API ─────────────────────────────────────────────────────────────────────
# Backend is deployed to Railway at `api.myastro360.com` (custom domain on the
# `myastro360/api` service). The `/api` suffix matches NestJS's global prefix
# set in apps/api/src/main.ts.
NEXT_PUBLIC_API_URL=https://api.myastro360.com/api

# ─── Firebase ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyDeuKHQMaChGzL2aHOs_ZDGi7LaVoI9GWg
# Our own host: next.config.ts proxies /__/auth/* and /__/firebase/* to
# jyotron-8a830.firebaseapp.com, so the Google sign-in popup opens on our
# domain (same-origin, no third-party-storage issues, no legacy branding).
# NOTE: the Vercel dashboard env var overrides this file — keep them in sync.
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=www.myastro360.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=jyotron-8a830
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=jyotron-8a830.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1060561795124
NEXT_PUBLIC_FIREBASE_APP_ID=1:1060561795124:web:680c397a239f9a0788b261

# ─── App Config ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=myastro360
NEXT_PUBLIC_APP_URL=https://myastro360.com
