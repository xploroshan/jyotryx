generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  USER
  PREMIUM
  ADMIN
}

enum Profession {
  SOFTWARE
  SALES
  MARKETING
  FINANCE
  STUDENT
  BUSINESS
  HEALTHCARE
  CREATIVE
  GOVERNMENT
  OTHER
}

enum AuthProvider {
  LOCAL
  GOOGLE
  APPLE
  PHONE
}

enum PlanType {
  FREE
  MONTHLY
  ANNUAL
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
}

enum MessageRole {
  USER
  ASSISTANT
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum PaymentType {
  CREDITS
  SUBSCRIPTION
  REPORT
}

enum ReportType {
  LIFE
  CAREER
  MARRIAGE
  WEALTH
  PALM
  ANNUAL
}

enum ReportStatus {
  GENERATING
  READY
  FAILED
}

enum CreditTransactionType {
  PURCHASE
  DAILY_FREE
  CHAT_DEDUCTION
  REPORT_PURCHASE
}

enum AdminAction {
  USER_UPDATE
  USER_DELETE
  USER_CREDITS_UPDATE
  USER_ROLE_CHANGE
  SUBSCRIPTION_CANCEL
  SUBSCRIPTION_UPDATE
}

// ─── Models ──────────────────────────────────────────────────────────────────

model User {
  id                String    @id @default(uuid()) @db.Uuid
  email             String    @unique
  phone             String?   @unique
  passwordHash      String?
  name              String
  dateOfBirth       DateTime?
  timeOfBirth       String?
  placeOfBirth      Json?     /// { lat: number, lng: number, name: string }
  gender            String?
  profession        Profession?
  profilePhoto      String?
  preferredLanguage String    @default("en")
  role              Role      @default(USER)
  credits           Int       @default(3)
  provider          AuthProvider @default(LOCAL)
  providerId        String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  lastCreditReset    DateTime?

  subscriptions      Subscription[]
  chatSessions       ChatSession[]
  kundliCharts       KundliChart[]
  matchingResults    MatchingResult[]
  palmistryReadings  PalmistryReading[]
  payments           Payment[]
  reports            Report[]
  creditTransactions CreditTransaction[]
  notifications      Notification[]
  tarotReadings      TarotReading[]
  llmUsage           LlmUsage[]

  @@index([email])
  @@index([phone])
  @@index([provider, providerId])
  @@map("users")
}

model Subscription {
  id                      String             @id @default(uuid()) @db.Uuid
  userId                  String             @db.Uuid
  plan                    PlanType           @default(FREE)
  status                  SubscriptionStatus @default(ACTIVE)
  razorpaySubscriptionId  String?            @unique
  startDate               DateTime           @default(now())
  endDate                 DateTime?
  createdAt               DateTime           @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([razorpaySubscriptionId])
  @@map("subscriptions")
}

model ChatSession {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  category  String
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@index([userId])
  @@index([userId, createdAt])
  @@map("chat_sessions")
}

model ChatMessage {
  id        String   @id @default(uuid()) @db.Uuid
  sessionId String   @db.Uuid
  role      MessageRole
  content   String
  createdAt DateTime @default(now())

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([sessionId, createdAt])
  @@map("chat_messages")
}

model KundliChart {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  name         String
  dateOfBirth  DateTime
  timeOfBirth  String
  placeOfBirth Json     /// { lat: number, lng: number, name: string }
  chartData    Json     /// Full computed chart data
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("kundli_charts")
}

model MatchingResult {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  personAName String
  personADob  DateTime
  personATime String
  personAPlace Json    /// { lat: number, lng: number, name: string }
  personBName String
  personBDob  DateTime
  personBTime String
  personBPlace Json    /// { lat: number, lng: number, name: string }
  gunaScore   Int
  manglikA    Boolean  @default(false)
  manglikB    Boolean  @default(false)
  resultData  Json     /// Full matching analysis
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("matching_results")
}

model PalmistryReading {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  imageUrl     String
  analysisData Json     /// AI-generated palm analysis
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("palmistry_readings")
}

model Payment {
  id                 String        @id @default(uuid()) @db.Uuid
  userId             String        @db.Uuid
  amount             Decimal       @db.Decimal(10, 2)
  currency           String        @default("INR")
  status             PaymentStatus @default(PENDING)
  razorpayOrderId    String?       @unique
  razorpayPaymentId  String?       @unique
  type               PaymentType
  metadata           Json?
  createdAt          DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([razorpayOrderId])
  @@index([razorpayPaymentId])
  @@map("payments")
}

model Report {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String       @db.Uuid
  type      ReportType
  status    ReportStatus @default(GENERATING)
  fileUrl   String?
  price     Decimal      @db.Decimal(10, 2)
  createdAt DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, type])
  @@map("reports")
}

model CreditTransaction {
  id          String                @id @default(uuid()) @db.Uuid
  userId      String                @db.Uuid
  amount      Int                   /// Positive for credits added, negative for deductions
  type        CreditTransactionType
  description String?
  createdAt   DateTime              @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, createdAt])
  @@map("credit_transactions")
}

model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("site_settings")
}

model ActivityLog {
  id           String      @id @default(uuid()) @db.Uuid
  adminId      String      @db.Uuid
  adminEmail   String
  action       AdminAction
  entityType   String      /// e.g. "User", "Subscription"
  entityId     String      @db.Uuid
  entityLabel  String?     /// Human-readable label e.g. user email
  previousData Json?       /// Snapshot before change
  newData      Json?       /// Snapshot after change
  undone       Boolean     @default(false)
  undoneAt     DateTime?
  createdAt    DateTime    @default(now())

  @@index([adminId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("activity_logs")
}

// ─── Notifications ──────────────────────────────────────────────────────────

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  title     String
  body      String
  type      String   @default("general") /// e.g. "general", "credit", "horoscope", "promo"
  read      Boolean  @default(false)
  data      Json?    /// Optional metadata
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, read])
  @@map("notifications")
}

// ─── Tarot ──────────────────────────────────────────────────────────────────

model TarotReading {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  spread         String   /// "single", "three-card", "celtic-cross"
  cards          Json     /// Array of drawn cards with positions
  interpretation Json     /// AI or deterministic interpretation
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("tarot_readings")
}

// ─── LLM Usage Tracking ─────────────────────────────────────────────────────

model LlmUsage {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String?  @db.Uuid /// Null when system-initiated (e.g. cron)
  provider         String   /// "openai", "anthropic", "google", "mistral", "cohere", "groq"
  model            String   /// e.g. "gpt-4o-mini"
  feature          String   /// e.g. "chat", "kundli", "palmistry", "tarot", "vastu", "numerology", "report", "briefing"
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  totalTokens      Int      @default(0)
  costUsd          Decimal  @default(0) @db.Decimal(12, 6)
  createdAt        DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, createdAt])
  @@index([createdAt])
  @@index([provider, model])
  @@map("llm_usage")
}

// ─── Knowledge Base ─────────────────────────────────────────────────────────

model KnowledgeDocument {
  id         String   @id @default(uuid()) @db.Uuid
  text       String   /// The chunk of text content
  category   String   /// e.g. "kundli", "horoscope", "dosha", "remedy", "matching", "panchang", "numerology", "palmistry", "general"
  topic      String?  /// Sub-topic e.g. "mars_in_7th_house", "mangal_dosha"
  source     String?  /// Book name or source reference
  embedding  Json?    /// Float[] vector stored as JSON (text-embedding-3-small: 1536 dims)
  keywords   String[] /// Extracted keywords for fast text search
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([category])
  @@index([category, topic])
  @@map("knowledge_documents")
}
