generator client {
  provider = "prisma-client-js"
  // Prisma 7 made the `client` engine the default and requires every
  // `new PrismaClient()` to be passed a driver adapter — see
  // `apps/api/src/prisma/prisma.service.ts`, which wires
  // `@prisma/adapter-pg` from `DATABASE_URL`. The legacy binary
  // engine is gone, so neither `binaryTargets` nor `engineType` apply.
}

datasource db {
  provider = "postgresql"
  // Connection URLs (`url` for the Supabase transaction pooler on port
  // 6543, `directUrl` for migrations on port 5432) are wired in
  // `prisma.config.ts` — Prisma 7 no longer accepts them in this block.
  // Without `directUrl`, migrations are issued over the pooler and can
  // deadlock or silently drop statements; the runtime URL still requires
  // `?pgbouncer=true` so Prisma disables prepared statements.
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  USER
  PREMIUM
  ADMIN
}

enum Profession {
  SOFTWARE
  SALES
  MARKETING
  FINANCE
  STUDENT
  BUSINESS
  HEALTHCARE
  CREATIVE
  GOVERNMENT
  OTHER
}

enum AuthProvider {
  LOCAL
  GOOGLE
  APPLE
  PHONE
}

enum PlanType {
  FREE
  MONTHLY
  ANNUAL
}

enum SubscriptionStatus {
  // PENDING: a live (Razorpay-hosted) subscription created but not yet charged.
  // Non-entitling — the subscription.activated/charged webhook flips it to ACTIVE.
  PENDING
  ACTIVE
  CANCELLED
  EXPIRED
}

enum MessageRole {
  USER
  ASSISTANT
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum PaymentType {
  CREDITS
  SUBSCRIPTION
  REPORT
}

enum EntitlementType {
  REPORT_LIFE
  REPORT_CAREER
  REPORT_MARRIAGE
  REPORT_WEALTH
  REPORT_ANNUAL
  REPORT_PALM
  PALMISTRY
}

enum ReportType {
  LIFE
  CAREER
  MARRIAGE
  WEALTH
  PALM
  ANNUAL
}

enum ReportStatus {
  GENERATING
  READY
  FAILED
}

enum CreditTransactionType {
  PURCHASE
  DAILY_FREE
  CHAT_DEDUCTION
  REPORT_PURCHASE
  ADMIN_GRANT
}

enum AdminAction {
  USER_UPDATE
  USER_DELETE
  USER_CREDITS_UPDATE
  USER_ROLE_CHANGE
  SUBSCRIPTION_CANCEL
  SUBSCRIPTION_UPDATE
}

enum AstrologyTradition {
  VEDIC
  WESTERN
  CHINESE
  HELLENISTIC
  HORARY
  MEDICAL
}

enum ReferralStatus {
  PENDING
  ACTIVATED
  REJECTED
}

enum BriefingStatus {
  SENT
  FAILED
  SKIPPED
}

// ─── Models ──────────────────────────────────────────────────────────────────

model User {
  id                  String               @id @default(uuid()) @db.Uuid
  email               String               @unique
  phone               String?              @unique
  passwordHash        String?
  name                String
  /// Optional informal name used to address the user in greetings,
  /// the chat surface, and feature-page heroes. The formal `name`
  /// field is still used as the chart subject inside astrology
  /// reports (kundli, matching, dasha, etc.) where the user's full
  /// legal name is what appears on the rendering.
  nickname            String?
  dateOfBirth         DateTime?
  timeOfBirth         String?
  placeOfBirth        Json? /// { lat: number, lng: number, name: string }
  gender              String?
  profession          Profession?
  profilePhoto        String?
  preferredLanguage   String               @default("en")
  astrologyTraditions AstrologyTradition[] @default([VEDIC, WESTERN, CHINESE, HELLENISTIC, HORARY, MEDICAL])
  primaryTradition    AstrologyTradition?
  role                Role                 @default(USER)
  credits             Int                  @default(3)
  provider            AuthProvider         @default(LOCAL)
  providerId          String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  // ─── Phase 2 growth-analytics dimensions ──────────────────────────────
  // All nullable so the ALTER TABLE is non-blocking and historical rows
  // stay valid. Populated at signup from Accept-Language (locale), the
  // first two subtags of Accept-Language (country hint), and a
  // client-supplied utm/source tag (signupSource). Funnel + cohort
  // queries group by these columns.
  locale       String? @db.VarChar(10)
  country      String? @db.VarChar(2)
  signupSource String? @db.VarChar(32)

  lastCreditReset DateTime?

  // ─── Referral program (Phase 1 monetization) ───────────────────────────
  // referralCode is the user's own shareable handle. Generated lazily —
  // see ReferralService.getOrCreateCode — so existing users get one the
  // first time they open the referral surface, no backfill needed.
  // referredById points to whoever invited this user (nullable; most
  // users have no referrer). The self-FK is ON DELETE SET NULL so
  // deleting a referrer doesn't cascade-nuke their referees.
  referralCode String?   @unique
  referredById String?   @db.Uuid
  referredAt   DateTime?

  // ─── Daily briefings opt-in (Phase 1 monetization) ─────────────────────
  // Single boolean toggle. Per-user send time is intentionally not
  // surfaced yet — the operator picks a global UTC hour from
  // `notification.briefing.send_hour_utc` so the scheduler stays a
  // single daily sweep instead of 24 cron windows.
  briefingEmailEnabled Boolean            @default(true)
  briefingDeliveries   BriefingDelivery[]

  referredBy User?  @relation("UserReferrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals  User[] @relation("UserReferrals")

  referralsMade    Referral[] @relation("ReferralReferrer")
  referralReceived Referral?  @relation("ReferralReferee")

  subscriptions      Subscription[]
  chatSessions       ChatSession[]
  kundliCharts       KundliChart[]
  matchingResults    MatchingResult[]
  palmistryReadings  PalmistryReading[]
  payments           Payment[]
  reports            Report[]
  creditTransactions CreditTransaction[]
  tarotReadings      TarotReading[]
  entitlements       Entitlement[]
  memories           UserMemory[]
  sharedMatches      SharedMatch[]
  deepDiveUnlocks    DeepDiveUnlock[]
  usageCounters      UsageCounter[]

  // Relations removed for partitioned tables (FK constraints dropped):
  // notifications, llmUsage — see 20260413_partition_tables migration

  @@index([email])
  @@index([phone])
  @@index([provider, providerId])
  @@index([locale])
  @@index([createdAt, locale])
  @@index([referredById])
  @@map("users")
}

/// One row per (user, feature-result) the user has unlocked a paid "deep dive"
/// interpretation for. `inputHash` is a stable hash of the domain + the result
/// payload, so the SAME chart re-opens the deep dive for free (no re-charge),
/// while a different result is a fresh unlock. The deep prose itself is served
/// from the LLM cache, not stored here.
model DeepDiveUnlock {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  domain    String
  inputHash String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, domain, inputHash])
  @@index([userId])
  @@map("deep_dive_unlocks")
}

/// Persistent personalization for the AI astrologer: durable facts, stated
/// preferences, goals and life events the user shares, so readings can say
/// "based on what you told me before…" across sessions. `kind` and `source`
/// are free-form strings (not enums) so new categories never need a migration.
model UserMemory {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  kind      String   @default("fact") /// fact | preference | goal | event
  content   String
  source    String   @default("user") /// user (entered) | system (captured)
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, createdAt])
  @@map("user_memories")
}

model Subscription {
  id                    String             @id @default(uuid()) @db.Uuid
  userId                String             @db.Uuid
  plan                  PlanType           @default(FREE)
  status                SubscriptionStatus @default(ACTIVE)
  /// Gateway subscription/mandate id (Cashfree `sub_…`; legacy Razorpay `sub_…`).
  gatewaySubscriptionId String?            @unique
  /// Which gateway owns this subscription: 'cashfree' or 'razorpay' (legacy). Null for non-gateway grants.
  provider              String?
  startDate             DateTime           @default(now())
  endDate               DateTime?
  // Provenance tag — populated when the subscription was granted by
  // something other than a gateway charge (currently 'REFERRAL').
  // Funnel/Cost tabs can group by this to separate paid revenue from
  // bonus-driven Premium without changing the existing PlanType enum.
  source                String?
  createdAt             DateTime           @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([gatewaySubscriptionId])
  @@index([source])
  @@map("subscriptions")
}

model Referral {
  id                     String         @id @default(uuid()) @db.Uuid
  referrerId             String         @db.Uuid
  refereeId              String         @db.Uuid
  /// Snapshot of the code used at redemption time — the referrer's
  /// `referralCode` could in theory change later, but the audit trail
  /// should still reflect what was actually shared.
  code                   String
  /// Snapshot of `referral.bonus_days` at activation time. Reading
  /// the live setting later would lie about historical activations.
  bonusDays              Int
  status                 ReferralStatus @default(ACTIVATED)
  /// Subscription rows the activation produced (or extended). Nullable
  /// for PENDING / REJECTED rows.
  referrerSubscriptionId String?        @db.Uuid
  refereeSubscriptionId  String?        @db.Uuid
  activatedAt            DateTime?
  /// Populated when status=REJECTED so the admin Activity tab can
  /// show why (e.g. "max_per_referrer cap reached").
  rejectedReason         String?
  createdAt              DateTime       @default(now())

  referrer User @relation("ReferralReferrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referee  User @relation("ReferralReferee", fields: [refereeId], references: [id], onDelete: Cascade)

  @@unique([refereeId])
  @@index([referrerId])
  @@index([status])
  @@map("referrals")
}

model BriefingDelivery {
  id         String         @id @default(uuid()) @db.Uuid
  userId     String         @db.Uuid
  /// The local "send date" the briefing represents. Stored as a DATE
  /// so the unique-constraint with userId+channel is exactly "one
  /// email per user per day", regardless of the actual send timestamp
  /// (which can drift across the scheduler's window).
  sendDate   DateTime       @db.Date
  channel    String         @default("email")
  status     BriefingStatus
  /// Provider message id (Resend / SES). Useful for support tickets
  /// and bounce correlation.
  providerId String?
  errorCode  String?
  createdAt  DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sendDate, channel])
  @@index([sendDate])
  @@index([status])
  @@map("briefing_deliveries")
}

/// Generic 2- or 3-way bucket store for experiments. The first user is
/// the paywall A/B test; the table shape is intentionally generic so a
/// later experiment ("free first chat" / "no free chat") can land
/// without a migration.
model ExperimentAssignment {
  experiment      String
  /// Either a real user UUID (`User.id`) or an anonymous-cookie value.
  /// Stored as TEXT so both fit; the typed FK lives in `userId`.
  userKey         String
  variant         String
  isAuthenticated Boolean   @default(false)
  userId          String?   @db.Uuid
  /// Set when the user converts (signs up, pays, etc.) so the admin
  /// dashboard can compute per-variant conversion rate.
  convertedAt     DateTime?
  conversionType  String?
  createdAt       DateTime  @default(now())

  @@id([experiment, userKey])
  @@index([experiment, variant])
  @@index([userId])
  @@index([convertedAt])
  @@map("experiment_assignments")
}

model ChatSession {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  category  String
  /// Optional persona the user picked on the "Chat with Astrologer"
  /// surface. Maps to a named astrologer config on the web; the API uses
  /// it to select a first-person human persona system prompt. Null for
  /// legacy/topic-only sessions.
  astrologerId String?
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  // messages relation removed — chat_messages is now a partitioned table

  @@index([userId])
  @@index([userId, createdAt])
  @@map("chat_sessions")
}

model ChatMessage {
  id        String   @default(uuid()) @db.Uuid
  sessionId String   @db.Uuid
  role      String /// "USER" | "ASSISTANT" (stored as text in partitioned table)
  content   String
  createdAt DateTime @default(now())

  // FK relation removed — partitioned tables cannot reference non-partitioned parents
  // Application-level integrity maintained via Prisma queries

  @@id([id, createdAt])
  @@index([sessionId])
  @@index([sessionId, createdAt])
  @@map("chat_messages")
}

model KundliChart {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  name         String
  dateOfBirth  DateTime
  timeOfBirth  String
  placeOfBirth Json /// { lat: number, lng: number, name: string }
  chartData    Json /// Full computed chart data
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("kundli_charts")
}

model MatchingResult {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  personAName  String
  personADob   DateTime
  personATime  String
  personAPlace Json /// { lat: number, lng: number, name: string }
  personBName  String
  personBDob   DateTime
  personBTime  String
  personBPlace Json /// { lat: number, lng: number, name: string }
  gunaScore    Int
  manglikA     Boolean  @default(false)
  manglikB     Boolean  @default(false)
  resultData   Json /// Full matching analysis
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("matching_results")
}

// A public, shareable snapshot of a Kundli-matching result. Holds only the
// *rendered* outcome (display names + scores + guna breakdown) — never the
// partners' raw birth details — so a share link can be opened by anyone
// without leaking date/time/place of birth. Cascade-deletes with the creator.
model SharedMatch {
  id             String   @id @default(uuid()) @db.Uuid
  token          String   @unique /// URL-safe public share token
  createdById    String?  @db.Uuid
  personAName    String
  personBName    String
  totalScore     Int
  maxScore       Int      @default(36)
  compatibility  String
  recommendation String
  manglikA       Boolean  @default(false)
  manglikB       Boolean  @default(false)
  gunaDetails    Json /// [{ guna, maxPoints, obtainedPoints, description }]
  locale         String?  @db.VarChar(10)
  viewCount      Int      @default(0)
  createdAt      DateTime @default(now())

  createdBy User? @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([createdById])
  @@map("shared_matches")
}

model PalmistryReading {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  imageUrl     String
  imageKey     String? /// R2 object key for the palm image
  analysisData Json /// AI-generated palm analysis
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("palmistry_readings")
}

model Payment {
  id               String        @id @default(uuid()) @db.Uuid
  userId           String        @db.Uuid
  amount           Decimal       @db.Decimal(10, 2)
  currency         String        @default("INR")
  status           PaymentStatus @default(PENDING)
  /// Payment-gateway order id (Cashfree `cf_<uuid>`; legacy Razorpay `order_…`).
  gatewayOrderId   String?       @unique
  /// Payment-gateway payment id (Cashfree `cf_payment_id`; legacy Razorpay `pay_…`).
  gatewayPaymentId String?       @unique
  /// Which gateway issued this payment: 'cashfree' (default) or 'razorpay' (legacy).
  provider         String        @default("cashfree")
  type             PaymentType
  metadata         Json?
  createdAt        DateTime      @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  entitlement Entitlement?

  @@index([userId])
  @@index([status])
  @@index([gatewayOrderId])
  @@index([gatewayPaymentId])
  @@index([provider])
  @@map("payments")
}

/// One-time pay-to-unlock grant for a paid feature (Reports, Palmistry).
/// A single SUCCESS payment grants exactly one Entitlement (paymentId is
/// unique → idempotent across the verify + webhook race). `consumedAt`
/// null means unused; it is set atomically when the user redeems the
/// unlock for one generation. Re-generation requires a fresh purchase.
model Entitlement {
  id          String          @id @default(uuid()) @db.Uuid
  userId      String          @db.Uuid
  type        EntitlementType
  paymentId   String          @unique @db.Uuid
  consumedAt  DateTime?
  consumedRef String?         @db.Uuid
  createdAt   DateTime        @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([userId, type, consumedAt])
  @@map("entitlements")
}

/// Per-user, per-feature usage meter for the subscription model (chat
/// messages, palmistry readings, report bundles). `periodKey` is "LIFETIME"
/// for free-tier allowances and a "YYYY-MM" billing month for subscribers, so
/// a new month is a fresh row (auto-reset) with no cron needed. Effective
/// allowance = the plan limit (site_settings `limits.<feature>.<tier>`) plus
/// `bonus` (purchased overage packs). Used instead of credit deduction when
/// `feature.credits_enabled` is off. The credit ledger is retained untouched
/// for the legacy/credits-on path and for audit.
model UsageCounter {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  feature   String /// "chat" | "palmistry" | "report_bundle"
  periodKey String /// "LIFETIME" | "YYYY-MM"
  used      Int      @default(0)
  bonus     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, feature, periodKey])
  @@index([userId])
  @@map("usage_counters")
}

model Report {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String       @db.Uuid
  type      ReportType
  status    ReportStatus @default(GENERATING)
  fileUrl   String?
  price     Decimal      @db.Decimal(10, 2)
  createdAt DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, type])
  @@map("reports")
}

model CreditTransaction {
  id          String                @id @default(uuid()) @db.Uuid
  userId      String                @db.Uuid
  amount      Int /// Positive for credits added, negative for deductions
  type        CreditTransactionType
  description String?
  createdAt   DateTime              @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, createdAt])
  @@map("credit_transactions")
}

model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("site_settings")
}

model ActivityLog {
  id           String    @default(uuid()) @db.Uuid
  adminId      String    @db.Uuid
  adminEmail   String
  action       String /// AdminAction values stored as text in partitioned table
  entityType   String /// e.g. "User", "Subscription"
  entityId     String    @db.Uuid
  entityLabel  String? /// Human-readable label e.g. user email
  previousData Json? /// Snapshot before change
  newData      Json? /// Snapshot after change
  undone       Boolean   @default(false)
  undoneAt     DateTime?
  createdAt    DateTime  @default(now())

  @@id([id, createdAt])
  @@index([adminId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("activity_logs")
}

// ─── Notifications ──────────────────────────────────────────────────────────

model Notification {
  id        String   @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  title     String
  body      String
  type      String   @default("general") /// e.g. "general", "credit", "horoscope", "promo"
  read      Boolean  @default(false)
  data      Json? /// Optional metadata
  createdAt DateTime @default(now())

  // FK relation removed — partitioned table

  @@id([id, createdAt])
  @@index([userId])
  @@index([userId, read])
  @@map("notifications")
}

// ─── Tarot ──────────────────────────────────────────────────────────────────

model TarotReading {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  spread         String /// "single", "three-card", "celtic-cross"
  cards          Json /// Array of drawn cards with positions
  interpretation Json /// AI or deterministic interpretation
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("tarot_readings")
}

// ─── LLM Usage Tracking ─────────────────────────────────────────────────────

model LlmUsage {
  id               String   @default(uuid()) @db.Uuid
  userId           String?  @db.Uuid /// Null when system-initiated (e.g. cron)
  provider         String /// "openai", "anthropic", "google", "mistral", "cohere", "groq"
  model            String /// e.g. "gpt-4o-mini"
  feature          String /// e.g. "chat", "kundli", "palmistry", "tarot", "vastu", "numerology", "report", "briefing"
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  totalTokens      Int      @default(0)
  costUsd          Decimal  @default(0) @db.Decimal(12, 6)
  // ─── Ops telemetry (added Apr 2026 for admin cost/perf dashboards) ───
  // All nullable or defaulted so the ALTER TABLE is partition-safe and
  // historical rows remain valid. Written by LlmService.recordUsage().
  //
  // Unlike the original camelCase columns above, these four were
  // shipped by `20260429_add_llm_usage_ops_columns/migration.sql` with
  // snake_case identifiers. The `@map` directives are mandatory — without
  // them, Prisma client would generate `INSERT INTO llm_usage ("cacheHit"...)`
  // and silently fail (recordUsage swallows errors), leaving every Ops
  // dashboard at zero.
  durationMs       Int?     @map("duration_ms") @db.Integer /// Wall-clock ms of the provider call. Null for cache hits and pre-instrumentation rows.
  cacheHit         Boolean  @default(false) @map("cache_hit") /// True when served from LlmCacheService Redis hit (tokens + cost are 0).
  errorCode        String?  @map("error_code") @db.VarChar(64) /// Null on success. "TIMEOUT","RATE_LIMIT","PROVIDER_ERROR","BAD_REQUEST"... Recorded so failures are visible in cost/error dashboards.
  retryCount       Int      @default(0) @map("retry_count") @db.SmallInt /// Failover depth: 0 = primary succeeded, 1 = second provider, 2 = third.
  createdAt        DateTime @default(now())

  // FK relation removed — partitioned table

  @@id([id, createdAt])
  @@index([userId])
  @@index([userId, createdAt])
  @@index([createdAt])
  @@index([provider, model])
  @@index([errorCode, createdAt])
  @@map("llm_usage")
}

// ─── Knowledge Base ─────────────────────────────────────────────────────────

model KnowledgeDocument {
  id        String   @id @default(uuid()) @db.Uuid
  text      String /// The chunk of text content
  category  String /// e.g. "kundli", "horoscope", "dosha", "remedy", "matching", "panchang", "numerology", "palmistry", "general"
  topic     String? /// Sub-topic e.g. "mars_in_7th_house", "mangal_dosha"
  source    String? /// Book name or source reference
  embedding Json? /// Float[] vector stored as JSON (text-embedding-3-small: 1536 dims)
  keywords  String[] /// Extracted keywords for fast text search
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([category, topic])
  @@map("knowledge_documents")
}

// ─── Structured Knowledge Base (Kb*) ────────────────────────────────────────
// Deterministic, typed entity tables that back features currently routed
// through the LLM translation path. Each row carries a per-locale `i18n`
// bag validated by `apps/api/src/knowledge/__tests__/integrity.spec.ts`.
// Lookups go through `KbService`; see `apps/api/src/knowledge/kb.service.ts`.
//
// `tradition` is null when a row is shared across systems (e.g. Sun is one
// KbPlanet row used by Vedic + Hellenistic narrative surfaces). Different
// entity → a separate row with `tradition` set, OR a dedicated table when
// the payload shape is different enough from the shared case — see
// `KbHellenisticPlanet` below for the B4 Hellenistic sect-aware overlay.

model KbPlanet {
  id        String   @id @default(uuid()) @db.Uuid
  key       String /// Canonical English identifier, e.g. "Sun"
  tradition String? /// Null = shared; else VEDIC/WESTERN/CHINESE/HELLENISTIC/HORARY/MEDICAL
  i18n      Json /// { en: { name, color, remedy, mantra, doList: string[], avoidList: string[] }, hi: {...}, ... }
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([key, tradition], name: "kb_planets_key_tradition_key", map: "kb_planets_key_tradition_key")
  @@index([tradition])
  @@map("kb_planets")
}

