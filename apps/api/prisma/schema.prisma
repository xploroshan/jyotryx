generator client {
  provider      = "prisma-client-js"
  // `native` picks the engine for the machine running `prisma generate`
  // (devs on macOS/Linux). `linux-musl-openssl-3.0.x` is the engine we
  // need for production on `node:20-alpine` (Alpine 3.19+, OpenSSL 3).
  // Without this, Prisma falls back to openssl-1.1.x on Alpine and
  // crashes at runtime with "Please manually install OpenSSL".
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  // Connection URLs (`url` for the Supabase transaction pooler on port
  // 6543, `directUrl` for migrations on port 5432) are wired in
  // `prisma.config.ts` — Prisma 7 no longer accepts them in this block.
  // Without `directUrl`, migrations are issued over the pooler and can
  // deadlock or silently drop statements; the runtime URL still requires
  // `?pgbouncer=true` so Prisma disables prepared statements.
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  USER
  PREMIUM
  ADMIN
}

enum Profession {
  SOFTWARE
  SALES
  MARKETING
  FINANCE
  STUDENT
  BUSINESS
  HEALTHCARE
  CREATIVE
  GOVERNMENT
  OTHER
}

enum AuthProvider {
  LOCAL
  GOOGLE
  APPLE
  PHONE
}

enum PlanType {
  FREE
  MONTHLY
  ANNUAL
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
}

enum MessageRole {
  USER
  ASSISTANT
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum PaymentType {
  CREDITS
  SUBSCRIPTION
  REPORT
}

enum ReportType {
  LIFE
  CAREER
  MARRIAGE
  WEALTH
  PALM
  ANNUAL
}

enum ReportStatus {
  GENERATING
  READY
  FAILED
}

enum CreditTransactionType {
  PURCHASE
  DAILY_FREE
  CHAT_DEDUCTION
  REPORT_PURCHASE
}

enum AdminAction {
  USER_UPDATE
  USER_DELETE
  USER_CREDITS_UPDATE
  USER_ROLE_CHANGE
  SUBSCRIPTION_CANCEL
  SUBSCRIPTION_UPDATE
}

enum AstrologyTradition {
  VEDIC
  WESTERN
  CHINESE
  HELLENISTIC
  HORARY
  MEDICAL
}

// ─── Models ──────────────────────────────────────────────────────────────────

model User {
  id                String    @id @default(uuid()) @db.Uuid
  email             String    @unique
  phone             String?   @unique
  passwordHash      String?
  name              String
  dateOfBirth       DateTime?
  timeOfBirth       String?
  placeOfBirth      Json?     /// { lat: number, lng: number, name: string }
  gender            String?
  profession        Profession?
  profilePhoto      String?
  preferredLanguage   String    @default("en")
  astrologyTraditions AstrologyTradition[] @default([VEDIC, WESTERN, CHINESE, HELLENISTIC, HORARY, MEDICAL])
  primaryTradition    AstrologyTradition?
  role              Role      @default(USER)
  credits           Int       @default(3)
  provider          AuthProvider @default(LOCAL)
  providerId        String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // ─── Phase 2 growth-analytics dimensions ──────────────────────────────
  // All nullable so the ALTER TABLE is non-blocking and historical rows
  // stay valid. Populated at signup from Accept-Language (locale), the
  // first two subtags of Accept-Language (country hint), and a
  // client-supplied utm/source tag (signupSource). Funnel + cohort
  // queries group by these columns.
  locale            String?   @db.VarChar(10)
  country           String?   @db.VarChar(2)
  signupSource      String?   @db.VarChar(32)

  lastCreditReset    DateTime?

  subscriptions      Subscription[]
  chatSessions       ChatSession[]
  kundliCharts       KundliChart[]
  matchingResults    MatchingResult[]
  palmistryReadings  PalmistryReading[]
  payments           Payment[]
  reports            Report[]
  creditTransactions CreditTransaction[]
  tarotReadings      TarotReading[]

  // Relations removed for partitioned tables (FK constraints dropped):
  // notifications, llmUsage — see 20260413_partition_tables migration

  @@index([email])
  @@index([phone])
  @@index([provider, providerId])
  @@index([locale])
  @@index([createdAt, locale])
  @@map("users")
}

model Subscription {
  id                      String             @id @default(uuid()) @db.Uuid
  userId                  String             @db.Uuid
  plan                    PlanType           @default(FREE)
  status                  SubscriptionStatus @default(ACTIVE)
  razorpaySubscriptionId  String?            @unique
  startDate               DateTime           @default(now())
  endDate                 DateTime?
  createdAt               DateTime           @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([razorpaySubscriptionId])
  @@map("subscriptions")
}

model ChatSession {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  category  String
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  // messages relation removed — chat_messages is now a partitioned table

  @@index([userId])
  @@index([userId, createdAt])
  @@map("chat_sessions")
}

model ChatMessage {
  id        String   @default(uuid()) @db.Uuid
  sessionId String   @db.Uuid
  role      String   /// "USER" | "ASSISTANT" (stored as text in partitioned table)
  content   String
  createdAt DateTime @default(now())

  // FK relation removed — partitioned tables cannot reference non-partitioned parents
  // Application-level integrity maintained via Prisma queries

  @@id([id, createdAt])
  @@index([sessionId])
  @@index([sessionId, createdAt])
  @@map("chat_messages")
}

model KundliChart {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  name         String
  dateOfBirth  DateTime
  timeOfBirth  String
  placeOfBirth Json     /// { lat: number, lng: number, name: string }
  chartData    Json     /// Full computed chart data
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("kundli_charts")
}

model MatchingResult {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  personAName String
  personADob  DateTime
  personATime String
  personAPlace Json    /// { lat: number, lng: number, name: string }
  personBName String
  personBDob  DateTime
  personBTime String
  personBPlace Json    /// { lat: number, lng: number, name: string }
  gunaScore   Int
  manglikA    Boolean  @default(false)
  manglikB    Boolean  @default(false)
  resultData  Json     /// Full matching analysis
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("matching_results")
}

model PalmistryReading {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  imageUrl     String
  imageKey     String?  /// R2 object key for the palm image
  analysisData Json     /// AI-generated palm analysis
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("palmistry_readings")
}

model Payment {
  id                 String        @id @default(uuid()) @db.Uuid
  userId             String        @db.Uuid
  amount             Decimal       @db.Decimal(10, 2)
  currency           String        @default("INR")
  status             PaymentStatus @default(PENDING)
  razorpayOrderId    String?       @unique
  razorpayPaymentId  String?       @unique
  type               PaymentType
  metadata           Json?
  createdAt          DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([razorpayOrderId])
  @@index([razorpayPaymentId])
  @@map("payments")
}

model Report {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String       @db.Uuid
  type      ReportType
  status    ReportStatus @default(GENERATING)
  fileUrl   String?
  price     Decimal      @db.Decimal(10, 2)
  createdAt DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, type])
  @@map("reports")
}

model CreditTransaction {
  id          String                @id @default(uuid()) @db.Uuid
  userId      String                @db.Uuid
  amount      Int                   /// Positive for credits added, negative for deductions
  type        CreditTransactionType
  description String?
  createdAt   DateTime              @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, createdAt])
  @@map("credit_transactions")
}

model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("site_settings")
}

model ActivityLog {
  id           String      @default(uuid()) @db.Uuid
  adminId      String      @db.Uuid
  adminEmail   String
  action       String      /// AdminAction values stored as text in partitioned table
  entityType   String      /// e.g. "User", "Subscription"
  entityId     String      @db.Uuid
  entityLabel  String?     /// Human-readable label e.g. user email
  previousData Json?       /// Snapshot before change
  newData      Json?       /// Snapshot after change
  undone       Boolean     @default(false)
  undoneAt     DateTime?
  createdAt    DateTime    @default(now())

  @@id([id, createdAt])
  @@index([adminId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("activity_logs")
}

// ─── Notifications ──────────────────────────────────────────────────────────

model Notification {
  id        String   @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  title     String
  body      String
  type      String   @default("general") /// e.g. "general", "credit", "horoscope", "promo"
  read      Boolean  @default(false)
  data      Json?    /// Optional metadata
  createdAt DateTime @default(now())

  // FK relation removed — partitioned table

  @@id([id, createdAt])
  @@index([userId])
  @@index([userId, read])
  @@map("notifications")
}

// ─── Tarot ──────────────────────────────────────────────────────────────────

model TarotReading {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  spread         String   /// "single", "three-card", "celtic-cross"
  cards          Json     /// Array of drawn cards with positions
  interpretation Json     /// AI or deterministic interpretation
