{
  "name": "@jyotryx/api",
  "version": "0.1.0",
  "private": true,
  "description": "Jyotryx Astrology App - NestJS Backend API",
  "scripts": {
    "build": "nest build && npx tsc prisma/seed.ts --outDir dist/prisma --target es2016 --module commonjs --moduleResolution node --esModuleInterop --resolveJsonModule --skipLibCheck 2>/dev/null || true",
    "start": "node scripts/startup.js",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "start:render": "node scripts/startup.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:int": "jest --config ./jest.integration.config.ts --runInBand",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "npx prisma migrate resolve --applied 20260101_init 2>/dev/null; npx prisma migrate resolve --applied 20260315_add_activity_log 2>/dev/null; npx prisma migrate resolve --applied 20260317_add_site_settings 2>/dev/null; npx prisma migrate resolve --applied 20260326_add_knowledge_base 2>/dev/null; npx prisma db execute --file prisma/migrations/20260101_init/migration.sql 2>/dev/null; npx prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:seed": "ts-node prisma/seed.ts"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.88.0",
    "@aws-sdk/client-s3": "^3.1029.0",
    "@aws-sdk/s3-request-presigner": "^3.1029.0",
    "@langchain/core": "^0.3.0",
    "@langchain/openai": "^0.3.0",
    "@nest-lab/throttler-storage-redis": "^1.2.0",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/cli": "^10.4.0",
    "@nestjs/common": "^10.4.0",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/schedule": "^6.1.1",
    "@nestjs/swagger": "^7.4.0",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/throttler": "^6.5.0",
    "@opentelemetry/auto-instrumentations-node": "^0.72.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.214.0",
    "@opentelemetry/sdk-node": "^0.214.0",
    "@prisma/client": "^5.18.0",
    "@prisma/instrumentation": "^7.7.0",
    "@sentry/node": "^10.48.0",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^4.17.0",
    "@types/node": "^22.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/uuid": "^10.0.0",
    "bcrypt": "^5.1.1",
    "bullmq": "^5.73.4",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cockatiel": "^3.2.1",
    "firebase-admin": "^13.7.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "nestjs-pino": "^4.6.1",
    "openai": "^4.55.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pino-http": "^11.0.0",
    "prisma": "^5.18.0",
    "prom-client": "^15.1.3",
    "razorpay": "^2.9.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swisseph": "^0.5.17",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.0",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@nestjs/schematics": "^10.1.0",
    "@nestjs/testing": "^10.4.0",
    "@types/jest": "^29.5.0",
    "@types/supertest": "^7.2.0",
    "jest": "^29.7.0",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "ts-jest": "^29.2.0"
  }
}
