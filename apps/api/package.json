{
  "name": "@jyotryx/api",
  "version": "0.1.0",
  "private": true,
  "description": "Jyotryx Astrology App - NestJS Backend API",
  "scripts": {
    "build": "nest build && npx tsc prisma/seed.ts --outDir dist/prisma --target es2016 --module commonjs --moduleResolution node --esModuleInterop --resolveJsonModule --skipLibCheck 2>/dev/null || true",
    "start": "node scripts/startup.js",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "start:render": "node scripts/startup.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:int": "jest --config ./jest.integration.config.ts --runInBand",
    "test:k6:chat": "k6 run test/k6/chat-message.js",
    "test:k6:kundli": "k6 run test/k6/astrology-kundli.js",
    "test:k6:palmistry": "k6 run test/k6/palmistry-analyze.js",
    "test:k6:all": "k6 run test/k6/full-suite.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "npx prisma migrate resolve --applied 20260101_init 2>/dev/null; npx prisma migrate resolve --applied 20260315_add_activity_log 2>/dev/null; npx prisma migrate resolve --applied 20260317_add_site_settings 2>/dev/null; npx prisma migrate resolve --applied 20260326_add_knowledge_base 2>/dev/null; npx prisma db execute --file prisma/migrations/20260101_init/migration.sql 2>/dev/null; npx prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:seed": "ts-node prisma/seed.ts",
    "kb:backfill": "ts-node scripts/backfill-locales.ts"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.96.0",
    "@aws-sdk/client-s3": "^3.1036.0",
    "@aws-sdk/s3-request-presigner": "^3.1036.0",
    "@langchain/core": "^1.1.41",
    "@langchain/openai": "^1.4.4",
    "@nest-lab/throttler-storage-redis": "^1.2.0",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/cli": "^11.0.21",
    "@nestjs/common": "^11.1.19",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.19",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.19",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.1",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/throttler": "^6.5.0",
    "@opentelemetry/auto-instrumentations-node": "^0.73.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.215.0",
    "@opentelemetry/sdk-node": "^0.215.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@prisma/instrumentation": "^7.8.0",
    "@sentry/node": "^10.50.0",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^25.6.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.20.0",
    "@types/uuid": "^10.0.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.76.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cockatiel": "^3.2.1",
    "firebase-admin": "^13.8.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "nestjs-pino": "^4.6.1",
    "openai": "^6.34.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.20.0",
    "pino-http": "^11.0.0",
    "prisma": "^7.8.0",
    "prom-client": "^15.1.3",
    "razorpay": "^2.9.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swisseph": "^0.5.17",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@nestjs/schematics": "^11.0.7",
    "@nestjs/testing": "^11.1.19",
    "@types/jest": "^29.5.0",
    "@types/supertest": "^7.2.0",
    "jest": "^29.7.0",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "ts-jest": "^29.2.0"
  }
}
