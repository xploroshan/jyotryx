# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://myastro360:myastro360_secret@localhost:5432/myastro360?schema=public
# Optional: read replica for analytics queries (falls back to primary if unset)
DATABASE_READ_REPLICA_URL=

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── JWT Auth ────────────────────────────────────────────────────────────────
JWT_SECRET=your-jwt-secret-change-me
JWT_REFRESH_SECRET=your-refresh-secret-change-me
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── OpenAI ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-api-key

# ─── Cashfree (Payment Gateway) ──────────────────────────────────────────────
CASHFREE_CLIENT_ID=your_cashfree_app_id
CASHFREE_CLIENT_SECRET=your_cashfree_secret_key
# Optional — falls back to CASHFREE_CLIENT_SECRET when left blank
CASHFREE_WEBHOOK_SECRET=
CASHFREE_ENV=sandbox
CASHFREE_API_VERSION=2025-01-01
# Subscription plan IDs created in the Cashfree dashboard (optional until subscriptions are used)
CASHFREE_PLAN_MONTHLY=
CASHFREE_PLAN_ANNUAL=

# ─── Google OAuth ────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ─── Firebase ───────────────────────────────────────────────────────────────
# Option 1: Full service account JSON (recommended for production)
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
# Option 2: Just project ID (limited - can't verify tokens in some environments)
FIREBASE_PROJECT_ID=your-firebase-project-id

# ─── Apple OAuth ─────────────────────────────────────────────────────────────
APPLE_CLIENT_ID=your-apple-client-id
APPLE_TEAM_ID=your-apple-team-id
APPLE_KEY_ID=your-apple-key-id

# ─── Pinecone (Vector DB) ───────────────────────────────────────────────────
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_ENVIRONMENT=us-east-1-aws
PINECONE_INDEX_NAME=myastro360-knowledge

# ─── AWS S3 (File Storage) ──────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=ap-south-1
AWS_S3_BUCKET=myastro360-uploads

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
# Public, internet-reachable base URL of this API (including the /api prefix),
# used to build the Cashfree webhook notify_url. Must be HTTPS in production.
API_PUBLIC_URL=http://localhost:4000/api

# ─── Rate Limiting ──────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60

# ─── Data Retention ─────────────────────────────────────────────────────────
# Number of months to keep partitioned data (llm_usage, chat_messages, etc.)
DATA_RETENTION_MONTHS=6

# ─── Analytics (optional) ──────────────────────────────────────────────────
# Set to enable ClickHouse-backed LLM analytics (e.g. http://localhost:8123)
CLICKHOUSE_URL=

# ─── Observability ──────────────────────────────────────────────────────────
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
