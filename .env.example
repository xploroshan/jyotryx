# Docker Compose environment variables
POSTGRES_USER=jyotron
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=jyotron
PGADMIN_EMAIL=admin@jyotron.com
PGADMIN_PASSWORD=your_secure_pgadmin_password_here

# ─── Admin bootstrap ──────────────────────────────────────────────────────
# On every API boot the server checks for an ADMIN user and creates one
# if it's missing, so you can always sign in as the admin even on a
# fresh database. In development the defaults below apply automatically;
# in production the server refuses to invent a password — ADMIN_PASSWORD
# must be set explicitly or the admin bootstrap is skipped.
#
#   ADMIN_EMAIL=admin@jyotron.com
#   ADMIN_PASSWORD=admin@jyotron2024
#
# Recovery: set ADMIN_BOOTSTRAP_RESET=true for a single boot to force a
# password reset + Redis lockout clear, then unset it and restart again.
#   ADMIN_BOOTSTRAP_RESET=true
#
# Promote existing registered users to ADMIN on boot without shelling
# into the DB. Idempotent; emails that don't exist yet are logged as a
# warning (register first, then restart). Comma-separated.
#   ADMIN_PROMOTE_EMAILS=someone@example.com,other@example.com
