{
  "name": "myastro360",
  "version": "1.0.0",
  "private": true,
  "description": "Vedic Astrology Platform - iOS | Android | Web",
  "workspaces": [
    "apps/web",
    "apps/api",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "dev:web": "cd apps/web && npm run dev",
    "dev:api": "cd apps/api && npm run start:dev",
    "db:migrate": "cd apps/api && npx prisma migrate dev",
    "db:seed": "cd apps/api && npx prisma db seed",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "social:daily": "node scripts/social/daily-post.mjs",
    "social:weekly": "node scripts/social/weekly-insights.mjs",
    "social:test": "node --test \"scripts/social/tests/*.mjs\""
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@types/supertest": "^7.2.0",
    "playwright": "^1.56.1",
    "supertest": "^7.2.2",
    "turbo": "^2.4.0"
  },
  "overrides": {
    "@nestjs/common": "^11.1.19",
    "@nestjs/core": "^11.1.19",
    "rxjs": "^7.8.2",
    "node-gyp": "^11.4.2",
    "tar": "^7.5.13",
    "cacache": "^20.0.0"
  },
  "packageManager": "npm@10.9.4",
  "engines": {
    "node": ">=20.0.0"
  }
}
